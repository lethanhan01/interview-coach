APP_ENV=development
PORT=8000
HOST=0.0.0.0
INTERNAL_AI_SECRET=dev-secret-internal-ai-key
LOG_LEVEL=INFO
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Embedding upstream (LM Studio OpenAI-compatible). Docker: http://host.docker.internal:1234/v1
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_S=30
