{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:next",
    "dev:clean": "npm run clean && npm run dev:next",
    "dev:next": "next dev --port 5173",
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }) } catch {}\"",
    "dev:all": "concurrently -k -n next,storybook -c blue,magenta npm:dev:next npm:storybook",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "stylelint": "stylelint \"**/*.module.css\" --allow-empty-input",
    "ui:lint": "node scripts/check-ui-rules.mjs",
    "verify:docs": "node scripts/verify-docs-integrity.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:a11y && npm run test:visual",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:a11y": "npx test-storybook",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:design-system": "npm run test:unit && npm run test:visual && npm run test:a11y"
  },
  "dependencies": {
    "@mantine/charts": "^9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/dropzone": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.4",
    "dayjs": "^1.11.23",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.5.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "storybook": "^10.5.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
