generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model RubricCategory {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contextPackId   String            @map("context_pack_id")
  categoryKey     String            @map("category_key")
  label           String
  weight          Float
  displayOrder    Int               @default(0) @map("display_order")
  criteria        RubricCriterion[]

  @@unique([contextPackId, categoryKey], map: "rubric_categories_context_category_key")
  @@index([contextPackId], map: "idx_rubric_categories_context_pack")
  @@map("rubric_categories")
}

model RubricCriterion {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricCategoryId String        @map("rubric_category_id") @db.Uuid
  code            String
  name            String
  weight          Float
  displayOrder    Int            @default(0) @map("display_order")
  active          Boolean        @default(true)
  rubricCategory  RubricCategory @relation(fields: [rubricCategoryId], references: [id], onDelete: Cascade)

  @@unique([rubricCategoryId, code], map: "rubric_criteria_category_code_key")
  @@index([rubricCategoryId], map: "idx_rubric_criteria_category")
  @@map("rubric_criteria")
}

enum QuestionSessionType {
  hr
  technical
}

model QuestionBank {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content          String
  sessionType      QuestionSessionType @map("session_type")
  difficulty       Int
  contextPackId    String            @map("context_pack_id")
  competencyDomains String[]          @default([]) @map("competency_domains")
  estimatedTimeMin  Int?              @map("estimated_time_min")
  translations     Json?
  contentJson      Json?             @map("content_json")
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessionQuestions SessionQuestion[]

  @@index([contextPackId], map: "idx_question_bank_context_pack", where: raw("(deleted_at IS NULL)"))
  @@index([sessionType, difficulty], map: "idx_question_bank_session_type_difficulty", where: raw("(deleted_at IS NULL)"))
  @@map("question_bank")
}

model User {
  id                   String                @id @db.Uuid
  email                String                @unique
  role                 String                @default("candidate")
  status               String                @default("active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  interviewSessions    InterviewSession[]
  savedJobDescriptions SavedJobDescription[]
  profile              UserProfile?
  resumes              Resume[]

  @@map("users")
}

model UserProfile {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  fullName           String?   @map("full_name")
  targetPosition     String?   @map("target_position")
  targetRoleCategory String?   @map("target_role_category")
  targetLevel        String?   @map("target_level")
  preferredTechStack String?   @map("preferred_tech_stack")
  personality        String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Resume {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  parsedJson       Json?    @map("parsed_json")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("resumes")
}

model SessionReport {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  reportType       String           @map("report_type")
  version          Int              @default(1)
  contentJson      Json             @map("content_json")
  generatedByModel String?          @map("generated_by_model")
  promptVersion    String?          @map("prompt_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reportType, version])
  @@map("session_reports")
}

model InterviewSession {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  savedJobDescriptionId String?              @map("saved_job_description_id") @db.Uuid
  jobDescription        String               @map("job_description")
  jobTitle              String?              @map("job_title")
  sessionType           String               @map("session_type")
  numQuestions          Int                  @default(5) @map("num_questions")
  durationMin           Int                  @default(30) @map("duration_min")
  remainingSeconds      Int?                 @map("remaining_seconds")
  language              String               @default("vi")
  contextPackId         String               @map("context_pack_id")
  status                String               @default("generating")
  overallScore          Int?                 @map("overall_score")
  completedAt           DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  savedJobDescription   SavedJobDescription? @relation(fields: [savedJobDescriptionId], references: [id], onDelete: SetNull)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionQuestions      SessionQuestion[]
  userAnswers           UserAnswer[]
  sessionReports        SessionReport[]

  @@index([createdAt(sort: Desc)], map: "idx_interview_sessions_created_at")
  @@index([savedJobDescriptionId], map: "idx_interview_sessions_saved_jd")
  @@index([userId, createdAt(sort: Desc)], map: "idx_interview_sessions_user_created")
  @@index([userId], map: "idx_interview_sessions_user_id")
  @@map("interview_sessions")
}

model SavedJobDescription {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  companyName    String             @map("company_name")
  companyWebsite String?            @map("company_website")
  jobTitle       String             @map("job_title")
  level          String?
  headcount      String?
  location       String?
  requirements   String
  jobContent     String             @map("job_content")
  techStack      String[]           @default([]) @map("tech_stack")
  benefits       String?
  salary         String?
  bonus          String?
  lastUsedAt     DateTime?          @map("last_used_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       InterviewSession[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_saved_job_descriptions_user_updated")
  @@index([userId, companyName, jobTitle], map: "idx_saved_job_descriptions_user_company_title")
  @@map("saved_job_descriptions")
}

model SessionQuestion {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  questionBankId   String?          @map("question_bank_id") @db.Uuid
  questionText     String           @map("question_text")
  orderIndex       Int              @map("order_index")
  questionCategory String           @map("question_category")
  competencyDomains String[]         @default([]) @map("competency_domains")
  rubricJson        Json             @map("rubric_json")
  estimatedTimeMin Int?             @map("estimated_time_min")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  questionBank     QuestionBank?    @relation(fields: [questionBankId], references: [id])
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userAnswers      UserAnswer[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId], map: "idx_session_questions_session_id")
  @@index([sessionId, questionText], map: "idx_session_questions_session_id_text")
  @@map("session_questions")
}

model UserAnswer {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String            @map("session_id") @db.Uuid
  questionId           String            @map("question_id") @db.Uuid
  answerMode           String            @map("answer_mode")
  answerText           String            @map("answer_text")
  audioFileUrl         String?           @map("audio_file_url")
  audioDurationSeconds Int?              @map("audio_duration_seconds")
  audioSizeBytes       Int?              @map("audio_size_bytes")
  skipped              Boolean           @default(false)
  voiceMetricsJson     Json?             @map("voice_metrics_json")
  transcriptionStatus  String?           @map("transcription_status")
  feedbackGenerated    Boolean           @default(false) @map("feedback_generated")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiFeedback           AiFeedback?
  question             SessionQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session              InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId], map: "idx_user_answers_question_id")
  @@index([sessionId], map: "idx_user_answers_session_id")
  @@map("user_answers")
}

model AiFeedback {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAnswerId      String             @unique @map("user_answer_id") @db.Uuid
  overallScore      Int                @map("overall_score")
  modelAnswer       String             @map("model_answer")
  keyTakeaway       String             @map("key_takeaway")
  promptVersion     String             @map("prompt_version")
  isFallback        Boolean            @default(false) @map("is_fallback")
  dimensionScores   Json?              @map("dimension_scores")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  userAnswer        UserAnswer         @relation(fields: [userAnswerId], references: [id], onDelete: Cascade)
  annotatedSegments AnnotatedSegment[]

  @@index([userAnswerId], map: "idx_ai_feedbacks_user_answer_id", where: raw("(user_answer_id IS NOT NULL)"))
  @@map("ai_feedbacks")
}

model AnnotatedSegment {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aiFeedbackId    String     @map("ai_feedback_id") @db.Uuid
  segmentText     String     @map("segment_text")
  startIndex      Int        @map("start_index")
  endIndex        Int        @map("end_index")
  highlightLevel  String     @map("highlight_level")
  annotation      String
  suggestion      String?
  improvedVersion String?    @map("improved_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  aiFeedback      AiFeedback @relation(fields: [aiFeedbackId], references: [id], onDelete: Cascade)

  @@index([aiFeedbackId], map: "idx_annotated_segments_feedback_id")
  @@map("annotated_segments")
}
