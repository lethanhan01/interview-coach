// Prisma schema for InterviewCoach MVP
// 12 tables — source of truth: docs/Design/DetailedDesign/database-design/

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Layer 0: Lookup ──────────────────────────────────────────────────────────

model ContextPack {
  id             String   @id @db.Text
  name           String   @db.Text
  rubricJson     Json     @map("rubric_json") @db.JsonB
  scoringWeights Json     @map("scoring_weights") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  questionBank      QuestionBank[]
  interviewSessions InterviewSession[]

  @@map("context_packs")
}

model QuestionBank {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content          String    @db.Text
  sessionType      String    @map("session_type") @db.Text
  difficulty       Int
  contextPackId    String    @map("context_pack_id") @db.Text
  subcategory      String    @db.Text
  competencyDomain String    @map("competency_domain") @db.Text
  applicableRoles  String[]  @map("applicable_roles")
  applicableLevels String[]  @map("applicable_levels")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  contextPack      ContextPack       @relation(fields: [contextPackId], references: [id])
  sessionQuestions SessionQuestion[]

  @@map("question_bank")
}

// ─── Layer 1: Auth ────────────────────────────────────────────────────────────

model User {
  id               String    @id @db.Uuid
  email            String    @unique @db.Text
  role             String    @default("candidate") @db.Text
  status           String    @default("active") @db.Text
  profileCompleted Boolean   @default(false) @map("profile_completed")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile           UserProfile?
  interviewSessions InterviewSession[]

  @@map("users")
}

model UserProfile {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  fullName           String    @map("full_name") @db.Text
  targetPosition     String    @map("target_position") @db.Text
  targetRoleCategory String    @map("target_role_category") @db.Text
  targetLevel        String    @map("target_level") @db.Text
  preferredTechStack String?   @map("preferred_tech_stack") @db.Text
  yearsExperience    Int       @default(0) @map("years_experience")
  defaultLanguage    String    @default("vi") @map("default_language") @db.Text
  ttsEnabled         Boolean   @default(false) @map("tts_enabled")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Layer 2: Session ─────────────────────────────────────────────────────────

model InterviewSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  jobDescription        String    @map("job_description") @db.Text
  jdSource              String    @map("jd_source") @db.Text
  jdUrl                 String?   @map("jd_url") @db.Text
  jobTitle              String?   @map("job_title") @db.Text
  sessionType           String    @map("session_type") @db.Text
  numQuestions          Int       @default(5) @map("num_questions")
  difficulty            String    @default("medium") @db.Text
  persona               String    @default("neutral_tech_lead") @db.Text
  mode                  String    @default("practice") @db.Text
  durationMin           Int       @default(30) @map("duration_min")
  language              String    @default("vi") @db.Text
  contextPackId         String    @map("context_pack_id") @db.Text
  showPrepCard          Boolean   @default(false) @map("show_prep_card")
  status                String    @default("generating") @db.Text
  planJson              Json?     @map("plan_json") @db.JsonB
  openingTranscript     String?   @map("opening_transcript") @db.Text
  selfEvalJson          Json?     @map("self_eval_json") @db.JsonB
  overallScore          Int?      @map("overall_score")
  executiveSummaryJson  Json?     @map("executive_summary_json") @db.JsonB
  commAnalysisJson      Json?     @map("comm_analysis_json") @db.JsonB
  competencyHeatmapJson Json?     @map("competency_heatmap_json") @db.JsonB
  reverseQEvalJson      Json?     @map("reverse_q_eval_json") @db.JsonB
  actionPlanJson        Json?     @map("action_plan_json") @db.JsonB
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextPack      ContextPack       @relation(fields: [contextPackId], references: [id])
  sessionQuestions SessionQuestion[]
  userAnswers      UserAnswer[]
  reverseQuestions ReverseQuestion[]

  @@map("interview_sessions")
}

model SessionQuestion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  questionBankId   String?  @map("question_bank_id") @db.Uuid
  questionText     String   @map("question_text") @db.Text
  orderIndex       Int      @map("order_index")
  questionCategory String   @map("question_category") @db.Text
  competencyDomain String   @map("competency_domain") @db.Text
  rubricJson       Json     @map("rubric_json") @db.JsonB
  estimatedTimeMin Int?     @map("estimated_time_min")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionBank QuestionBank?    @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  userAnswers  UserAnswer[]

  @@unique([sessionId, orderIndex])
  @@map("session_questions")
}

// ─── Layer 3: Answer & Feedback ───────────────────────────────────────────────

model UserAnswer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String    @map("session_id") @db.Uuid
  questionId           String    @map("question_id") @db.Uuid
  answerMode           String    @map("answer_mode") @db.Text
  answerText           String    @map("answer_text") @db.Text
  audioFileUrl         String?   @map("audio_file_url") @db.Text
  audioDurationSeconds Int?      @map("audio_duration_seconds")
  audioSizeBytes       Int?      @map("audio_size_bytes")
  skipped              Boolean   @default(false)
  voiceMetricsJson     Json?     @map("voice_metrics_json") @db.JsonB
  feedbackGenerated    Boolean   @default(false) @map("feedback_generated")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         SessionQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  followUpQuestion FollowUpQuestion?
  aiFeedback       AiFeedback?

  @@map("user_answers")
}

model FollowUpQuestion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAnswerId       String   @unique @map("user_answer_id") @db.Uuid
  followUpText       String   @map("follow_up_text") @db.Text
  triggerRule        String   @map("trigger_rule") @db.Text
  triggerReason      String?  @map("trigger_reason") @db.Text
  followUpAnswerText String?  @map("follow_up_answer_text") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  userAnswer UserAnswer @relation(fields: [userAnswerId], references: [id], onDelete: Cascade)

  @@map("follow_up_questions")
}

model AiFeedback {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAnswerId  String   @unique @map("user_answer_id") @db.Uuid
  overallScore  Int      @map("overall_score")
  modelAnswer   String   @map("model_answer") @db.Text
  keyTakeaway   String   @map("key_takeaway") @db.Text
  promptVersion String   @map("prompt_version") @db.Text
  isFallback    Boolean  @default(false) @map("is_fallback")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  userAnswer        UserAnswer         @relation(fields: [userAnswerId], references: [id], onDelete: Cascade)
  annotatedSegments AnnotatedSegment[]

  @@map("ai_feedbacks")
}

model AnnotatedSegment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aiFeedbackId    String   @map("ai_feedback_id") @db.Uuid
  segmentText     String   @map("segment_text") @db.Text
  startIndex      Int      @map("start_index")
  endIndex        Int      @map("end_index")
  highlightLevel  String   @map("highlight_level") @db.Text
  annotation      String   @db.Text
  suggestion      String?  @db.Text
  improvedVersion String?  @map("improved_version") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  aiFeedback AiFeedback @relation(fields: [aiFeedbackId], references: [id], onDelete: Cascade)

  @@map("annotated_segments")
}

// ─── Layer 4: Features & Audit ────────────────────────────────────────────────

model ReverseQuestion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  questionText      String   @map("question_text") @db.Text
  answerMode        String   @default("text") @map("answer_mode") @db.Text
  aiResponse        String   @map("ai_response") @db.Text
  evaluationLabel   String   @map("evaluation_label") @db.Text
  evaluationComment String?  @map("evaluation_comment") @db.Text
  orderIndex        Int      @map("order_index")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@map("reverse_questions")
}

model AiQualityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  jobType       String   @map("job_type") @db.Text
  promptVersion String   @map("prompt_version") @db.Text
  model         String   @db.Text
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int      @map("latency_ms")
  isFallback    Boolean  @default(false) @map("is_fallback")
  errorCode     String?  @map("error_code") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_quality_log")
}
