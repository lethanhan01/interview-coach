{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "module": {
    "type": "commonjs"
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@infra/*": ["src/infrastructure/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "exclude": ["\\.spec\\.ts$", "\\.e2e-spec\\.ts$"],
  "minify": false
}
