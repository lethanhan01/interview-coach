{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "db:prepare-user-answer-unique": "ts-node prisma/prepare-user-answer-unique.ts",
    "db:prepare-db-push-raw-sql": "ts-node prisma/prepare-db-push-raw-sql.ts",
    "db:test-user-answer-migration": "ts-node prisma/test-user-answer-deduplication-copy.ts",
    "db:verify:pre": "ts-node prisma/verify-db-hardening.ts --phase=pre",
    "db:verify": "ts-node prisma/verify-db-hardening.ts --phase=post",
    "db:test-constraints": "ts-node prisma/test-db-hardening-constraints.ts",
    "db:sync": "npm run db:sync:full",
    "db:sync:prisma": "prisma generate && npm run db:prepare-user-answer-unique && npm run db:prepare-db-push-raw-sql && prisma db push",
    "db:sync:full": "npm run db:validate && npm run db:verify:pre && prisma generate && npm run db:prepare-user-answer-unique && npm run db:prepare-db-push-raw-sql && prisma db push && npm run db:apply-sql && npm run db:verify",
    "db:apply-sql": "prisma db execute --file ./prisma/migrations/migration.sql",
    "infra:up": "docker compose -f docker-compose.yml up -d redis",
    "infra:down": "docker compose -f docker-compose.yml down",
    "verify:runtime": "node scripts/verify-runtime.js",
    "dev:local": "npm run infra:up && npm run start:dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run prisma:generate",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.interface.ts",
      "!**/*.d.ts",
      "!**/*.spec.ts",
      "!**/main.ts",
      "!**/seed.ts",
      "!**/prompts/**",
      "!**/pipeline.schemas.ts",
      "!**/mixed.pipeline.service.ts",
      "!**/technical.pipeline.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
