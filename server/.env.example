# Copy to .env. Never commit real credentials.

# PostgreSQL / Supabase database
# DATABASE_URL: transaction-mode pooler; DIRECT_URL: session-mode connection for migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_TIMEZONE=Asia/Ho_Chi_Minh
PRISMA_POOL_MAX=5
PRISMA_CONNECTION_TIMEOUT_MS=30000
PRISMA_IDLE_TIMEOUT_MS=30000
PRISMA_TRANSACTION_MAX_WAIT_MS=15000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
PRISMA_CONNECT_RETRIES=3
PRISMA_CONNECT_RETRY_DELAY_MS=1500

# Supabase
# Obtain these from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Server-only secret. Required for Storage uploads and admin seed; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# Authentication
# Set true outside local MVP development. The server verifies Supabase access tokens.
AUTH_ENABLED=true
MAINTENANCE_MODE=false
WORKERS_ENABLED=true
# Used only when AUTH_ENABLED=false.
MOCK_USER_ID=
# Optional on normal startup. Required together when running `npm run seed` to create/promote the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<minimum-12-character-admin-password>

# Application / CORS
NODE_ENV=production
PORT=3000
CLIENT_URL=https://<your-client-domain>
SESSION_CREATION_LIMIT_PER_24H=10

# Redis (BullMQ + SSE Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
FEEDBACK_WORKER_CONCURRENCY=2

# OpenAI-compatible provider
OPENAI_API_KEY=<provider-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=<chat-model>
OPENAI_FEEDBACK_MODEL=
OPENAI_REPORT_MODEL=
OPENAI_JSON_MODE=true
OPENAI_TIMEOUT_MS=30000
OPENAI_FEEDBACK_TIMEOUT_MS=420000
OPENAI_REPORT_TIMEOUT_MS=600000
OPENAI_QUESTION_TIMEOUT_MS=240000
OPENAI_QUESTION_MAX_TOKENS=2400

# Optional comma-separated extra hosts allowed for downloading uploaded audio.
AUDIO_ALLOWED_HOSTS=
