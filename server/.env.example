# Copy to .env. Never commit real credentials.

# PostgreSQL Database (Self-hosted trên VPS Host)
# Khi deploy với Docker Compose lên VPS, kết nối tới PostgreSQL host OS qua host.docker.internal:5432
# (Cần cấu hình postgresql.conf listen_addresses='*' và pg_hba.conf cho phép dải IP Docker 172.16.0.0/12)
# Nếu chạy dev trực tiếp trên máy không dùng Docker, thay host.docker.internal bằng localhost
DATABASE_URL=postgresql://interviewai_user:your_secure_password@host.docker.internal:5432/interviewai?schema=public
DIRECT_URL=postgresql://interviewai_user:your_secure_password@host.docker.internal:5432/interviewai?schema=public
DB_TIMEZONE=Asia/Ho_Chi_Minh
PRISMA_POOL_MAX=5
PRISMA_CONNECTION_TIMEOUT_MS=30000
PRISMA_IDLE_TIMEOUT_MS=30000
PRISMA_TRANSACTION_MAX_WAIT_MS=15000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
PRISMA_CONNECT_RETRIES=3
PRISMA_CONNECT_RETRY_DELAY_MS=1500

# Local account authentication
AUTH_JWT_SECRET=<at-least-32-random-characters>
AUTH_COOKIE_NAME=intervia_auth
AUTH_COOKIE_MAX_AGE=86400
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=no-reply@example.com
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAINTENANCE_MODE=false
# Runtime role: api exposes HTTP without processors; worker consumes queues without HTTP;
# all preserves the legacy combined process. RUNTIME_ROLE takes precedence over WORKERS_ENABLED.
# Khi chạy với docker-compose trên VPS, role được set tự động trong từng service container (api / worker).
RUNTIME_ROLE=all
WORKERS_ENABLED=true
# Optional on normal startup. Required together when running `npm run seed` to create/promote the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<minimum-12-character-admin-password>

# Application / CORS
NODE_ENV=production
PORT=3000
CLIENT_URL=https://<your-client-domain>
SESSION_CREATION_LIMIT_PER_24H=10

# Redis (BullMQ + SSE Pub/Sub)
# Khi deploy với Docker Compose, REDIS_HOST là tên service: 'redis'
# Khi chạy local không dùng docker-compose, dùng 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
# SSE Redis timeouts (ms): connect for both clients, command only for the publisher
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=3000
FEEDBACK_WORKER_CONCURRENCY=2

# OpenAI-compatible provider
OPENAI_API_KEY=<provider-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=<chat-model>
OPENAI_FEEDBACK_MODEL=
OPENAI_REPORT_MODEL=
OPENAI_JSON_MODE=true

# AI Service (Python FastAPI Speech & AI Engine)
AI_STT_PROVIDER=python
AI_TTS_PROVIDER=python
AI_SERVICE_URL=http://localhost:8000
INTERNAL_AI_SECRET=dev-secret-internal-ai-key
AI_STT_TIMEOUT_MS=60000
OPENAI_TIMEOUT_MS=30000
OPENAI_FEEDBACK_TIMEOUT_MS=420000
OPENAI_REPORT_TIMEOUT_MS=600000
OPENAI_QUESTION_TIMEOUT_MS=240000
OPENAI_QUESTION_MAX_TOKENS=2400

