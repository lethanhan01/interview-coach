{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "contracts/.*\\.contract\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@core/(.*)$": "<rootDir>/../src/core/$1",
    "^@infra/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
