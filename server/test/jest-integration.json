{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/e2e-env.ts"],
  "testRegex": ".integration-spec.ts$",
  "testTimeout": 20000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@core/(.*)$": "<rootDir>/../src/core/$1",
    "^@infra/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
